---
import { Image } from '@astrojs/image/components';
import profilePic from './profile-pic.jpg';
---

<aside class="my-12 flex items-center">
  <Image
    class="mr-3 h-12 w-12 rounded-full"
    width={48}
    height={48}
    src={profilePic}
    alt="My profile pic"
  />
  <div class="text-base text-slate-700 dark:text-slate-300">
    <p>
      Personal blog by <a href="https://twitter.com/nobuhikosawai"
        >nobuhikosawai</a
      >.
    </p>
    <p>
      I am a web engineer, sort of working on both backend and frontend. All
      views are my own.
    </p>
  </div>
</aside>
